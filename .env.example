# Copy to .env.local for local dev (CRA requires REACT_APP_ prefix).
# Production on Vercel: set the same values in
# Vercel Dashboard → Project → Settings → Environment Variables.
REACT_APP_SUPABASE_URL=https://xyzcompany.supabase.co
REACT_APP_SUPABASE_ANON_KEY=paste-anon-public-key-here

# Vercel serverless /api/* uses these (no REACT_APP_ prefix):
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY=paste-anon-public-key-here

# ---- Payment + delivery (server only — never prefix with REACT_APP_) ----
# Supabase service_role key: bypasses RLS. Server only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# PromptPay proxy (phone number or citizen id) used to build the QR.
# Recommend a dedicated/secondary number so your personal one is not encoded in the QR.
PROMPTPAY_PROXY=0XXXXXXXXX

# SlipOK slip verification (see https://slipok.com/api-documentation/)
SLIPOK_API_KEY=paste-slipok-api-key
SLIPOK_BRANCH_ID=paste-slipok-branch-id
# SLIPOK_API_URL=https://api.slipok.com/api/line/apikey

# Resend transactional email
RESEND_API_KEY=paste-resend-api-key
EMAIL_FROM=DearDev <onboarding@resend.dev>

# Public site URL, used for links inside emails (no trailing slash)
SITE_URL=https://your-domain.example

# Storage bucket for the .zip files (must be PRIVATE)
# DIGITAL_BUCKET=digital-products

# Behaviour overrides (optional)
# DOWNLOAD_LIMIT=3
# SIGNED_URL_TTL=300
# QR_TTL_MINUTES=15
