# Copy to .env.local for local dev (CRA requires REACT_APP_ prefix).
# Production on Vercel: set the same values in
# Vercel Dashboard → Project → Settings → Environment Variables.
REACT_APP_SUPABASE_URL=https://xyzcompany.supabase.co
REACT_APP_SUPABASE_ANON_KEY=paste-anon-public-key-here

# Vercel serverless /api/* uses these (no REACT_APP_ prefix):
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_ANON_KEY=paste-anon-public-key-here

# ---- Payment + delivery (server only — never prefix with REACT_APP_) ----
# Supabase service_role key: bypasses RLS. Server only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# PromptPay proxy (phone number or citizen id) used to build the QR.
# Recommend a dedicated/secondary number so your personal one is not encoded in the QR.
PROMPTPAY_PROXY=0XXXXXXXXX

# SlipOK slip verification (see https://slipok.com/api-documentation/)
# Both values come from the SlipOK LINE LIFF after choosing the "API" channel.
# BRANCH_ID is the number in the sample URL: .../api/line/apikey/<BRANCH_ID>
# API_KEY is the value of the x-authorization header in the same sample.
SLIPOK_API_KEY=paste-slipok-api-key
SLIPOK_BRANCH_ID=paste-slipok-branch-id
# SLIPOK_API_URL=https://api.slipok.com/api/line/apikey

# Email is OPTIONAL. Leave these empty to run without any email provider:
# the success page shows the licence + download link and tells the buyer to
# save it. Two transports are supported — SMTP wins when both are configured.
#
# 1) Gmail SMTP via nodemailer (no custom domain needed; free tier ~500/day).
#    Steps: enable 2-Step Verification on the Google account, then create an
#    App Password (16 chars) and paste it as SMTP_PASS. EMAIL_FROM must be the
#    same Gmail account as SMTP_USER.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=myshop@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=myshop@gmail.com
#
# 2) Resend HTTP API — only useful once a real domain is verified there
#    (a .vercel.app URL cannot be verified, so it cannot send to customers).
# RESEND_API_KEY=
# EMAIL_FROM=

# Public site URL, used for links inside emails (no trailing slash).
# If empty/localhost, the API derives the URL from the request headers.
SITE_URL=https://your-domain.example

# Signs the success/download links (optional; falls back to the service-role key).
# If you set it, set the SAME value on Vercel — otherwise server-generated links
# and CLI links will not match.
# ORDER_TOKEN_SECRET=generate-a-long-random-string

# Storage bucket for the .zip files (must be PRIVATE)
# DIGITAL_BUCKET=digital-products

# Behaviour overrides (optional)
# DOWNLOAD_LIMIT=3
# SIGNED_URL_TTL=300
# QR_TTL_MINUTES=15

# Abandoned-checkout safety net and abuse guards (optional)
# QR_GRACE_MINUTES=120          # still accept a slip this long after the QR expires
# MAX_VERIFY_ATTEMPTS=12        # SlipOK checks per order before we stop (each costs a credit)
# CHECKOUT_WINDOW_MINUTES=10
# CHECKOUT_MAX_PER_WINDOW=5     # max new orders per email inside the window
# MAX_SLIP_BYTES=4000000        # reject bigger uploads server-side (Vercel body cap ≈ 4.5 MB)
# SLIP_CLOCK_SKEW_MINUTES=5     # tolerance when comparing slip time with order.created_at
# SLIPOK_LOG=false              # keep SlipOK's dashboard log off to reduce PII
# ALLOW_SLIP_DATA=0             # production only accepts uploaded images

# Per-IP abuse guards (optional — see supabase/hardening.sql for the counter)
# CHECKOUT_MAX_PER_IP=10        # max new orders per IP inside the window (0 = off)
# VERIFY_MAX_PER_IP=6           # max slip verifications per IP (each one costs a SlipOK credit) (0 = off)
# RATE_LIMIT_WINDOW_SECONDS=600 # how long the per-IP budget lasts
